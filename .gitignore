# Public repo in output/: keep only site files + public vulnerability data
*

# Track directories and selected files
!/.gitignore
!/README.md
!/index.html
!/CNAME
!/.nojekyll
!/assets/
!/assets/**
!/scripts/
!/scripts/update_dashboard_counts.py
!/.github/
!/.github/**
!/vulns/
!/vulns/**
!/pocs/
!/pocs/**
!/exploits/
!/exploits/**
